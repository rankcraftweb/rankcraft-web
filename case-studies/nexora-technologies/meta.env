# Metadata for one case study. This is sourced as a bash file, so quote
# any value containing spaces.
#
# Required:
TITLE="Nexora Technologies"
CLIENT_NAME="Nexora Technologies LLC"
PROJECT_URL="https://nexorany.com"

# Optional: up to 4 stats shown as the stat row on the case study page.
# A stat only gets set if both its NUMBER and LABEL are present.
#
# Mobile performance is deliberately NOT one of these. Two PageSpeed runs
# on 22 September returned 89 and 91 - Speed Index came back 4.81 s and
# then 2.77 s on an unchanged page - so any single number here would be a
# claim the measurement does not support, and the stat row has no room to
# say "between". The range is in the body text where it can be explained.
# Every figure below held identical across both runs.
STAT1_NUMBER="99"
STAT1_LABEL="Performance (desktop)"
STAT2_NUMBER="100"
STAT2_LABEL="Accessibility"
STAT3_NUMBER="100"
STAT3_LABEL="Best practices"
STAT4_NUMBER="100"
STAT4_LABEL="SEO"

# Optional: exactly one of these two for the featured image.
# FEATURED_IMAGE points to a local file, relative to this directory,
# that gets uploaded and attached. FEATURED_IMAGE_ID instead reuses an
# image already in the media library by attachment ID.
FEATURED_IMAGE="nexora-home.jpg"
# FEATURED_IMAGE_ID="123"
