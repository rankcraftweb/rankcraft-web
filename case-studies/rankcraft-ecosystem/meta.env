# Metadata for one case study. This is sourced as a bash file, so quote
# any value containing spaces.
#
# Required:
TITLE="The RankCraft Ecosystem"
CLIENT_NAME="RankCraft (Founder Project)"
PROJECT_URL="https://rankcraftweb.com"

# Captured from the live post before it was deleted on 24 September 2026,
# so this directory can rebuild it exactly. The theme uses post_excerpt as
# the meta description and the portfolio card text.
EXCERPT="Three connected products built solo: this site, the free audit tool that feeds it, and the system that tracks every lead end to end."

# Optional: up to 4 stats shown as the stat row on the case study page.
# A stat only gets set if both its NUMBER and LABEL are present.
STAT1_NUMBER="3"
STAT1_LABEL="Connected products"
STAT2_NUMBER="2"
STAT2_LABEL="Tech stacks (WordPress + Next.js)"
STAT3_NUMBER="100"
STAT3_LABEL="% automated, audit to lead"
STAT4_NUMBER="0"
STAT4_LABEL="Manual steps or third-party tools required"

# Optional: exactly one of these two for the featured image.
# FEATURED_IMAGE points to a local file, relative to this directory,
# that gets uploaded and attached. FEATURED_IMAGE_ID instead reuses an
# image already in the media library by attachment ID.
# FEATURED_IMAGE="screenshot.jpg"
# FEATURED_IMAGE_ID="346"

# Both images this case study used were deleted from the media library on
# 24 September 2026 and are kept here instead. FEATURED_IMAGE points at the
# one that was set as the thumbnail (attachment 422).
#
# rankcraft-ecosystem-homepage-scaled.png was attachment 385, the inline
# image in content.html. A restore needs it re-uploaded and the <img> src
# in content.html pointed at wherever it lands - the old URL is gone, so
# that reference is dead until someone fixes it.
FEATURED_IMAGE="rankcraft-web-homepage-2026-09.png"
