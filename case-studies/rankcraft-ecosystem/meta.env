# Metadata for one case study. This is sourced as a bash file, so quote
# any value containing spaces.
#
# Required:
TITLE="The RankCraft Ecosystem"
CLIENT_NAME="RankCraft (Founder Project)"
PROJECT_URL="https://rankcraftweb.com"

# Optional: up to 4 stats shown as the stat row on the case study page.
# A stat only gets set if both its NUMBER and LABEL are present.
STAT1_NUMBER="3"
STAT1_LABEL="Connected products"
STAT2_NUMBER="2"
STAT2_LABEL="Tech stacks (WordPress + Next.js)"
STAT3_NUMBER="100"
STAT3_LABEL="% automated, audit to lead"
STAT4_NUMBER="0"
STAT4_LABEL="Manual steps or third-party tools required"

# Optional: exactly one of these two for the featured image.
# FEATURED_IMAGE points to a local file, relative to this directory,
# that gets uploaded and attached. FEATURED_IMAGE_ID instead reuses an
# image already in the media library by attachment ID.
# FEATURED_IMAGE="screenshot.jpg"
# FEATURED_IMAGE_ID="346"
