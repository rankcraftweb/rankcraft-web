# Metadata for one case study. This is sourced as a bash file, so quote
# any value containing spaces.
#
# Required:
TITLE="Paver Sealing Academy"
CLIENT_NAME="Paver Sealing Academy"
PROJECT_URL="https://paversealingacademy.com"

# The theme uses post_excerpt as the meta description for case studies.
EXCERPT="A hands-on paver sealing course that had no website at all, built from scratch: four pages, Course schema, and a clean 100 across the board on desktop."

# Up to 4 stats. The archive card shows the first three, the case study
# page shows all four.
#
# 94 rather than 98 for mobile performance: two runs minutes apart
# returned both, and quoting the better sample is not measuring. The other
# three did not move between runs.
STAT1_NUMBER="94"
STAT1_LABEL="Performance (mobile)"
STAT2_NUMBER="100"
STAT2_LABEL="Accessibility"
STAT3_NUMBER="100"
STAT3_LABEL="SEO"
STAT4_NUMBER="0"
STAT4_LABEL="Layout shift"

# The homepage screenshot, already imported to the media library as part
# of preparing the inline images in content.html.
FEATURED_IMAGE_ID="403"
