# Server details for bin/deploy.sh and bin/deploy-case-study.sh.
#
# Copy this file to bin/.deploy.env and fill in the real values from
# Hostinger hPanel > Advanced > SSH Access. bin/.deploy.env is git-ignored,
# so the host, user and port never end up in this public repo.
SSH_KEY="$HOME/.ssh/hostinger_rankcraftweb"
SSH_PORT=22
SSH_HOST="user@your-server-ip"
REMOTE_WP_PATH="~/domains/rankcraftweb.com/public_html"
